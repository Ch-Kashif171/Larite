#!/usr/bin/env php
<?php

use Core\Foundation\Application;
use Symfony\Component\Console\Application  as App;

const ROOT_PATH = __DIR__;

/*
|--------------------------------------------------------------------------
| Register The Auto Loader
|--------------------------------------------------------------------------
|
| Composer provides a convenient, automatically generated class loader
| for our application. We just need to utilize it! We'll require it
| into the script here so that we do not have to worry about the
| loading of any of our classes manually. It's great to relax.
|
*/
require_once 'vendor/autoload.php';

/*
|--------------------------------------------------------------------------
| Run The Application
|--------------------------------------------------------------------------
|
| Once we have the application, we can handle the incoming request using
| the application's HTTP kernel. Then, we will send the response back
| to this client's browser, allowing them to enjoy our application.
|
*/
$app = require_once ROOT_PATH . '/bootstrap/app.php';

/***********************************************************/

/*
|--------------------------------------------------------------------------
| Start The Larite Console Application
|--------------------------------------------------------------------------
|
| When we run the console application, the current CLI command will be
| executed in this console and the response sent back to a terminal
| or another output device for the developers. Here goes nothing!
|
*/
$application = new App("Welcome to ".Application::framework()." Developed By Kashif Sohail, Version: ", Application::version());

/*
|--------------------------------------------------------------------------
| Run The Console Kernel
|--------------------------------------------------------------------------
|
| Here we create the Console kernel instance for the framework. The kernel
| is responsible for bootstrapping the application when running in the CLI
| environment. It prepares all available console commands and then calls
| $app->init() internally to execute the given command.
|
| Finally, we exit with the return code from "handle()", ensuring that the
| CLI process returns the correct status to the operating system.
|
*/
$kernel = new Core\Console\ConsoleKernel($app);

exit($kernel->handle());
