{
    "name": "larite/larite",
    "description": "The skeleton application for the Larite framework",
    "keywords": ["framework", "Larite"],
    "license" : "MIT",
    "type": "project",
    "authors" : [
        {
            "name": "kashif sohail",
            "email": "amkashif171@gmail.com"
        }
    ],

    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Migrations\\": "database/migrations/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "larite/framework": "^6.1"

    },

    "require-dev": {
        "symfony/var-dumper": "^7.3"
    },
    "autoload-dev": {
        "files": [
        ]
    },

    "extra": {
        "installer-paths": {
            "vendor": ["vendor"]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
